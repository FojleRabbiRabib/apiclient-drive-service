{
    "name": "fojlerabbirabib/apiclient-drive-service",
    "description": "A slim, auto-synced, Drive-only subset of google/apiclient-services (unofficial, not affiliated with Google).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["google", "google-drive", "google-api", "apiclient", "drive"],
    "homepage": "https://github.com/FojleRabbiRabib/apiclient-drive-service",
    "support": {
        "issues": "https://github.com/FojleRabbiRabib/apiclient-drive-service/issues",
        "source": "https://github.com/FojleRabbiRabib/apiclient-drive-service"
    },
    "require": {
        "php": "^8.1",
        "google/apiclient": "^2.15"
    },
    "conflict": {
        "google/apiclient-services": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "roave/backward-compatibility-check": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Google\\Service\\": "src"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
